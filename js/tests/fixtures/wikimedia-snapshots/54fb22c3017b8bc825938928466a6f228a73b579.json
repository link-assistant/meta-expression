          {
            "definition": "<span class=\"usage-label-sense\" about=\"#mwt9\" typeof=\"mw:Transclusion\"></span> To give something a definite <a rel=\"mw:WikiLink\" href=\"/wiki/form\" title=\"form\">form</a>; to <a rel=\"mw:WikiLink\" href=\"/wiki/shape\" title=\"shape\">shape</a>."
          },
          {
            "definition": "<span class=\"usage-label-sense\" about=\"#mwt10\" typeof=\"mw:Transclusion\"></span> To develop into a definite <a rel=\"mw:WikiLink\" href=\"/wiki/form\" title=\"form\">form</a>."
          },
          {
            "definition": "To give something a <a rel=\"mw:WikiLink\" href=\"/wiki/formal\" title=\"formal\">formal</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/official\" title=\"official\">official</a> standing."
          },
          {
            "definition": "To act with <a rel=\"mw:WikiLink\" href=\"/wiki/formality\" title=\"formality\">formality</a>."
          },
          {
            "definition": "<span class=\"usage-label-sense\" about=\"#mwt12\" typeof=\"mw:Transclusion\"></span> To rigorously prove a mathematical result."
          }
        ]
